<?xml version="1.0" encoding="utf-8"?>
<!-- The release build (ADR-0007): one self-contained executable that runs without .NET installed. How to run it: docs/agents/releases.md. -->
<Project>

  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- No native DLL needs it today: it keeps any future one inside the executable, so it still ships alone. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- WinForms can't be trimmed. -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishDir>bin\publish\win-x64\</PublishDir>
  </PropertyGroup>

</Project>
