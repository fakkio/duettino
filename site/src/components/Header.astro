---
import {TEXT, type Lang} from "../utils/constants";
import DarkToggle from "./DarkToggle.astro";

interface Props {
  lang: Lang;
  counterpart?: string;
}

const {lang, counterpart} = Astro.props;
const t = TEXT[lang];
const other = lang === "en" ? "it" : "en";
---

<header class="header container">
  <div class="brand">
    <img class="theme-light" src="/assets/web/icon-light.svg" alt="" width="56" height="56" />
    <img class="theme-dark" src="/assets/web/icon-dark.svg" alt="" width="56" height="56" />
    <h1>Duettino</h1>
  </div>
  <nav class="actions" aria-label={lang === "en" ? "Language and theme" : "Lingua e tema"}>
    {counterpart && <a
      class="lang-switch"
      href={counterpart}
      lang={other}
      hreflang={other}
      aria-label={t.switchAria}>{t.switchLabel}</a>}
    <DarkToggle lang={lang} />
  </nav>
</header>

<style>
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex: 0 0 auto;
    margin-bottom: 1rem;
  }

  .header.container {
    padding-top: 1rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .brand h1 {
    margin: 0;
  }

  /* The language link and the toggle stay on the right, even when the row wraps. */
  .actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-left: auto;
  }
</style>
