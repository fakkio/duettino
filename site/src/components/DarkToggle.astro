---
// The icon itself (sun rays / moon mask) still animates the old way: a CSS
// transition reacting to the ancestor data-theme attribute through the
// cascade — cx/cy/r are SVG geometry properties, so a CSS override on them
// transitions like any other property.
//
// The page-wide theme swap additionally goes through the View Transitions
// API: the click handler starts a view transition around the data-theme
// flip, and a clip-path circle grows from the button's centre on
// ::view-transition-new(root), revealing the new theme underneath — same
// idea as Telegram's theme toggle. Browsers without support (or with
// prefers-reduced-motion) just flip the attribute directly, same as before.
// The button disables itself for the duration of the transition rather than
// supporting overlapping reveals, which isn't worth the complexity here.
---

<button type="button" class="toggle" data-dark-toggle aria-pressed="false" aria-label="Switch to the dark theme">
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="32"
    height="32"
    viewBox="0 0 24 24"
    fill="none"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    stroke="currentColor"
    aria-hidden="true"
    class="icon"
  >
    <mask id="darkToggleMask">
      <rect x="0" y="0" width="100%" height="100%" fill="white"></rect>
      <circle class="maskCircle" cx="100%" cy="0%" r="9" fill="black"></circle>
    </mask>

    <circle
      class="centerCircle"
      cx="12"
      cy="12"
      r="5"
      mask="url(#darkToggleMask)"
      fill="currentColor"></circle>
    <g class="rays" stroke="currentColor">
      <line x1="12" y1="1" x2="12" y2="3"></line>
      <line x1="12" y1="21" x2="12" y2="23"></line>
      <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
      <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
      <line x1="1" y1="12" x2="3" y2="12"></line>
      <line x1="21" y1="12" x2="23" y2="12"></line>
      <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
      <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
    </g>
  </svg>
</button>

<style>
  :global(::view-transition-old(root)) {
    animation: none;
  }

  :global(::view-transition-new(root)) {
    animation: reveal-circle 500ms cubic-bezier(0.65, 0, 0.35, 1) both;
  }

  @keyframes reveal-circle {
    from {
      clip-path: circle(0 at var(--reveal-x, 100%) var(--reveal-y, 0%));
    }
    to {
      clip-path: circle(
        var(--reveal-radius, 150%) at var(--reveal-x, 100%) var(--reveal-y, 0%)
      );
    }
  }

  .toggle {
    cursor: pointer;
    color: #e67e22;
    background: none;
    border: none;
    padding: 0;
    display: inline-flex;
    transition: color 600ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .toggle:disabled {
    cursor: default;
  }

  .icon {
    transform: rotate(90deg);
    transition: transform 600ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .centerCircle {
    transition: r 600ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .maskCircle {
    transition:
      cx 600ms cubic-bezier(0.34, 1.56, 0.64, 1),
      cy 600ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .rays {
    transition: opacity 600ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  :global([data-theme="dark"]) .toggle {
    color: #ecf0f1;
  }

  :global([data-theme="dark"]) .icon {
    transform: rotate(40deg);
  }

  :global([data-theme="dark"]) .centerCircle {
    r: 9px;
  }

  :global([data-theme="dark"]) .maskCircle {
    cx: 50%;
    cy: 23%;
  }

  :global([data-theme="dark"]) .rays {
    opacity: 0;
  }
</style>

<script>
  import {COLOR_MODE_KEY} from "../utils/constants";

  const LABELS = {
    light: "Switch to the dark theme",
    dark: "Switch to the light theme",
  };

  const button =
    document.querySelector<HTMLButtonElement>("[data-dark-toggle]");

  const sync = (theme: string) => {
    button?.setAttribute("aria-label", LABELS[theme as keyof typeof LABELS]);
    button?.setAttribute("aria-pressed", String(theme === "dark"));
  };

  if (button) {
    sync(document.documentElement.dataset.theme ?? "light");

    button.addEventListener("click", () => {
      const root = document.documentElement;
      const next = root.dataset.theme === "dark" ? "light" : "dark";

      const applyTheme = () => {
        root.dataset.theme = next;
        localStorage.setItem(COLOR_MODE_KEY, next);
        sync(next);
      };

      const reducedMotion = matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;

      if (!document.startViewTransition || reducedMotion) {
        applyTheme();
        return;
      }

      const rect = button.getBoundingClientRect();
      const x = rect.left + rect.width / 2;
      const y = rect.top + rect.height / 2;
      const radius = Math.hypot(
        Math.max(x, innerWidth - x),
        Math.max(y, innerHeight - y),
      );
      root.style.setProperty("--reveal-x", `${x}px`);
      root.style.setProperty("--reveal-y", `${y}px`);
      root.style.setProperty("--reveal-radius", `${radius}px`);

      button.disabled = true;
      const transition = document.startViewTransition(applyTheme);
      transition.finished.finally(() => {
        button.disabled = false;
      });
    });
  }
</script>
